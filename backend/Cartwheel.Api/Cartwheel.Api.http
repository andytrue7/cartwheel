@baseUrl = http://localhost:5189

### 1. List products, first page (expect 200, a page of up to 20 items sorted by name)
GET {{baseUrl}}/api/products
Accept: application/json

> {%
    client.global.set("productId", response.body.items[0].id);
%}

### 2. Existing product (expect 200). Run request 1 first to set productId.
GET {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### 3. Unknown Guid (expect 404 with a ProblemDetails body)
GET {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000
Accept: application/json

### 4. Not a Guid (expect 404 with an empty body: the :guid route constraint doesn't match)
GET {{baseUrl}}/api/products/abc
Accept: application/json

### 5. List categories (expect 200)
GET {{baseUrl}}/api/categories
Accept: application/json

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.global.set("categoryId", response.body[0].id);
%}

### 6. Create product (expect 201 + Location)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Framework Laptop 13",
  "description": "Repairable laptop",
  "price": 1049,
  "stockQuantity": 5,
  "categoryId": "{{categoryId}}"
}

> {%
    client.test("201 with Location", () => {
        client.assert(response.status === 201);
        client.assert(response.headers.valueOf("Location") !== null);
    });
    client.global.set("createdId", response.body.id);
%}

### 7. Create with invalid fields (expect 400)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "   ",
  "price": 0,
  "stockQuantity": -1,
  "categoryId": "{{categoryId}}"
}

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 8. Create without categoryId (expect 400)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "No category",
  "price": 10
}

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 9. Create with unknown category (expect 400)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Orphan",
  "price": 10,
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 10. Update product (expect 204)
PUT {{baseUrl}}/api/products/{{createdId}}
Content-Type: application/json

{
  "name": "Framework Laptop 13 (2026)",
  "description": null,
  "price": 999,
  "categoryId": "{{categoryId}}"
}

> {% client.test("204", () => client.assert(response.status === 204)); %}

### 11. Read it back (expect 200 with the new name)
GET {{baseUrl}}/api/products/{{createdId}}
Accept: application/json

> {%
    client.test("updated", () => {
        client.assert(response.status === 200);
        client.assert(response.body.name === "Framework Laptop 13 (2026)");
    });
%}

### 12. Update unknown id (expect 404)
PUT {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Ghost",
  "price": 10,
  "categoryId": "{{categoryId}}"
}

> {% client.test("404", () => client.assert(response.status === 404)); %}

### 13. Update with invalid body (expect 400)
PUT {{baseUrl}}/api/products/{{createdId}}
Content-Type: application/json

{
  "name": "",
  "price": -5,
  "categoryId": "{{categoryId}}"
}

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 14. Delete (expect 204)
DELETE {{baseUrl}}/api/products/{{createdId}}

> {% client.test("204", () => client.assert(response.status === 204)); %}

### 15. Delete the same product again (expect 404)
DELETE {{baseUrl}}/api/products/{{createdId}}

> {% client.test("404", () => client.assert(response.status === 404)); %}

### 16. Search: case-insensitive, part of the name (expect 200, only names containing "mac")
GET {{baseUrl}}/api/products?search=MAC
Accept: application/json

> {%
    client.test("names contain 'mac'", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.length > 0);
        client.assert(response.body.items.every(p => p.name.toLowerCase().includes("mac")));
    });
%}

### 17. Category filter (expect 200, only that category). Run request 5 first to set categoryId.
GET {{baseUrl}}/api/products?categoryId={{categoryId}}
Accept: application/json

> {%
    client.test("single category", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.length > 0);
        client.assert(response.body.items.every(p => p.categoryId === client.global.get("categoryId")));
    });
%}

### 18. In stock only (expect 200, no product with zero stock)
GET {{baseUrl}}/api/products?inStock=true
Accept: application/json

> {%
    client.test("all in stock", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.every(p => p.stockQuantity > 0));
    });
%}

### 19. Sort by price, cheapest first (expect 200, prices never go down)
GET {{baseUrl}}/api/products?sort=priceAsc
Accept: application/json

> {%
    client.test("price ascending", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.every((p, i, all) => i === 0 || all[i - 1].price <= p.price));
    });
%}

### 20. Sort by price, most expensive first (expect 200, prices never go up)
GET {{baseUrl}}/api/products?sort=priceDesc
Accept: application/json

> {%
    client.test("price descending", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.every((p, i, all) => i === 0 || all[i - 1].price >= p.price));
    });
%}

### 21. All filters combined (expect 200, every product passes every filter)
GET {{baseUrl}}/api/products?search=o&categoryId={{categoryId}}&inStock=true&sort=priceDesc
Accept: application/json

> {%
    client.test("all filters apply", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.every(p =>
            p.name.toLowerCase().includes("o")
            && p.categoryId === client.global.get("categoryId")
            && p.stockQuantity > 0));
        client.assert(response.body.items.every((p, i, all) => i === 0 || all[i - 1].price >= p.price));
    });
%}

### 22. Invalid sort value (expect 400 with a ProblemDetails body naming "Sort")
GET {{baseUrl}}/api/products?sort=cheapest
Accept: application/json

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 23. Category id that doesn't exist (expect 200 with no items: filters narrow, they don't validate)
GET {{baseUrl}}/api/products?categoryId=00000000-0000-0000-0000-000000000000
Accept: application/json

> {%
    client.test("empty list", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.length === 0);
        client.assert(response.body.totalCount === 0);
    });
%}

### 24. Page 2 of size 5 (expect 200, 5 items, page 2, totalPages consistent with totalCount)
GET {{baseUrl}}/api/products?page=2&pageSize=5
Accept: application/json

> {%
    client.test("page 2", () => {
        client.assert(response.status === 200);
        client.assert(response.body.page === 2);
        client.assert(response.body.pageSize === 5);
        client.assert(response.body.items.length === 5);
        client.assert(response.body.totalPages === Math.ceil(response.body.totalCount / 5));
    });
%}

### 25. Page beyond the last (expect 200 with no items but the real totalCount, not 404)
GET {{baseUrl}}/api/products?page=999&pageSize=5
Accept: application/json

> {%
    client.test("empty page, real total", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.length === 0);
        client.assert(response.body.totalCount > 0);
    });
%}

### 26. Page size above the maximum (expect 400 ProblemDetails naming "PageSize")
GET {{baseUrl}}/api/products?pageSize=101
Accept: application/json

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 27. Page 0 (expect 400)
GET {{baseUrl}}/api/products?page=0
Accept: application/json

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 28. Page that would overflow int in (page - 1) * pageSize (expect 400)
GET {{baseUrl}}/api/products?page=2147483647&pageSize=100
Accept: application/json

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 29. Paging combined with a filter (expect 200, totalCount counts only matching products)
GET {{baseUrl}}/api/products?inStock=true&page=1&pageSize=3&sort=priceAsc
Accept: application/json

> {%
    client.test("filtered page", () => {
        client.assert(response.status === 200);
        client.assert(response.body.items.length <= 3);
        client.assert(response.body.items.every(p => p.stockQuantity > 0));
    });
%}

### 30. Increase stock (expect 200 with the updated product). Run request 1 first to set productId.
POST {{baseUrl}}/api/products/{{productId}}/stock/increase
Content-Type: application/json

{
  "quantity": 5
}

> {%
    client.test("200 with new stock", () => {
        client.assert(response.status === 200);
        client.assert(response.body.id === client.global.get("productId"));
    });
    client.global.set("stock", response.body.stockQuantity);
%}

### 31. Decrease within stock (expect 200, stock goes down by 2)
POST {{baseUrl}}/api/products/{{productId}}/stock/decrease
Content-Type: application/json

{
  "quantity": 2
}

> {%
    client.test("200, stock reduced", () => {
        client.assert(response.status === 200);
        client.assert(response.body.stockQuantity === client.global.get("stock") - 2);
    });
%}

### 32. Decrease beyond stock (expect 409 ProblemDetails with requestedQuantity and availableQuantity)
POST {{baseUrl}}/api/products/{{productId}}/stock/decrease
Content-Type: application/json

{
  "quantity": 100000
}

> {%
    client.test("409 with numbers", () => {
        client.assert(response.status === 409);
        client.assert(response.body.requestedQuantity === 100000);
        client.assert(typeof response.body.availableQuantity === "number");
    });
%}

### 33. Quantity 0 (expect 400 from validation, the domain is never called)
POST {{baseUrl}}/api/products/{{productId}}/stock/increase
Content-Type: application/json

{
  "quantity": 0
}

> {% client.test("400", () => client.assert(response.status === 400)); %}

### 34. Stock change on an unknown id (expect 404)
POST {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000/stock/decrease
Content-Type: application/json

{
  "quantity": 1
}

> {% client.test("404", () => client.assert(response.status === 404)); %}
